#include <behaviors.dtsi>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "zmk-helpers/helper.h"
#include <behaviors/num_word.dtsi>

#define DEF 0
#define SYM 1
#define NAV 2
#define NUM 3
#define FUN 4

#define QUICK_TAP_MS 175

&sk {  // sticky-key config
    release-after-ms = <900>;  // release after 0.9s
    quick-release;             // no double capitalization when rolling keys
};

&sl {  // sticky-layer config
    ignore-modifiers;          // allow chording sticky mods & layers
};

&lt {  // layer-tap config
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
};

&mt { // mod-tap config
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

// tap: num-word | double-tap: sticky num-layer | hold: num-layer
#define _SMART_NUM &smart_num NUM 0
ZMK_HOLD_TAP(smart_num,
    flavor = "balanced";
    tapping-term-ms = <200>;
    quick-tap-ms = <QUICK_TAP_MS>;
    bindings = <&mo>, <&num_dance>;
)
ZMK_TAP_DANCE(num_dance,
    tapping-term-ms = <200>;
    bindings = <&num_word NUM>, <&sl NUM>;  // reverse this for sticky-num on single tap
)
&num_word {  // num-word, from zmk-auto-layer module
    continue-list = <BSPC DEL DOT COMMA PLUS MINUS STAR FSLH EQUAL>;
};

// tap: sticky-shift | shift + tap/ double-tap: caps-word | hold: shift
ZMK_MOD_MORPH(smart_shft,
    bindings = <&sk LSHFT>, <&caps_word>;
    mods = <(MOD_LSFT)>;
)

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_Base {
            display-name = "Base";
            bindings = <
//    ┌────────────┬─────┬─────┬─────┬─────┬─────┐         ┌─────┬─────┬─────┬─────┬─────┬────────────┐
//    │   mo FUN   │  Q  │  W  │  E  │  R  │  T  │         │  Y  │  U  │  I  │  O  │  P  │            │
//    ├────────────┼─────┼─────┼─────┼─────┼─────┤         ├─────┼─────┼─────┼─────┼─────┼────────────┤
//    │    ESC     │  A  │  S  │  D  │  F  │  G  │         │  H  │  J  │  K  │  L  │  ;  │ key_repeat │
//    ├────────────┼─────┼─────┼─────┼─────┼─────┤         ├─────┼─────┼─────┼─────┼─────┼────────────┤
//    │ _SMART_NUM │  Z  │  X  │  C  │  V  │  B  │         │  N  │  M  │  ,  │  .  │  /  │            │
//    └────────────┴─────┴─────┴─────┴─────┴─────┘         └─────┴─────┴─────┴─────┴─────┴────────────┘
//                      ┌─────────────┬────────────┬─────────────┐ ┌────────────┬────────────┬──────┐
//                      │ smart_shft  │ lctl/bspc  │  sym/tab    │ │  nav/ret   │  lalt/spc  │ lgui │
//                      └─────────────┴────────────┴─────────────┘ └────────────┴────────────┴──────┘
    &mo FUN      &kp Q   &kp W   &kp E   &kp R   &kp T       &kp Y   &kp U   &kp I       &kp O     &kp P      &trans
    &kp ESC      &kp A   &kp S   &kp D   &kp F   &kp G       &kp H   &kp J   &kp K       &kp L     &kp SEMI   &key_repeat
    _SMART_NUM   &kp Z   &kp X   &kp C   &kp V   &kp B       &kp N   &kp M   &kp COMMA   &kp DOT   &kp FSLH   &trans
                    &mt LCTRL BSPC   &lt SYM TAB   &smart_shft       &kp LGUI   &lt NAV RET   &mt LALT SPACE
            >;
        };

        layer_Sym {
            display-name = "Sym";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐         ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │  ^  │  \  │  ~  │  /  │  $  │         │  '  │  [  │  ]  │  &  │  :  │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤         ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │  *  │  +  │  _  │  -  │  =  │         │  "  │  (  │  )  │  ?  │  ;  │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤         ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │  !  │  @  │  #  │  <  │  >  │         │  `  │  {  │  }  │  |  │  %  │     │
//    └─────┴─────┴─────┴─────┴─────┴─────┘         └─────┴─────┴─────┴─────┴─────┴─────┘
//                      ┌─────┬─────┬─────┐         ┌─────┬─────┬─────┐
//                      │     │     │     │         │     │     │     │
//                      └─────┴─────┴─────┘         └─────┴─────┴─────┘
    &trans   &kp CARET   &kp BSLH   &kp TILDE   &kp FSLH    &kp DLLR       &kp SQT     &kp LBKT   &kp RBKT   &kp AMPS    &kp COLON   &trans
    &trans   &kp STAR    &kp PLUS   &kp UNDER   &kp MINUS   &kp EQUAL      &kp DQT     &kp LPAR   &kp RPAR   &kp QMARK   &kp SEMI    &trans
    &trans   &kp EXCL    &kp AT     &kp HASH    &kp LT      &kp GT         &kp GRAVE   &kp LBRC   &kp RBRC   &kp PIPE    &kp PRCNT   &trans
                                    &trans   &trans   &trans       &trans   &trans   &trans
            >;
        };

        layer_Nav {
            display-name = "Nav";
            bindings = <
//    ┌─────┬─────────┬─────────┬─────────┬─────────┬─────────┐         ┌────────────┬────────────┬──────────┬────────────┬─────┬─────┐
//    │     │ lgui(1) │ lgui(2) │ lgui(3) │ lgui(4) │ lgui(5) │         │ lgui(left) │ lgui(down) │ lgui(up) │ lgui(rght) │     │     │
//    ├─────┼─────────┼─────────┼─────────┼─────────┼─────────┤         ├────────────┼────────────┼──────────┼────────────┼─────┼─────┤
//    │     │ lalt(1) │ lalt(2) │ lalt(3) │ lalt(4) │ lalt(5) │         │   lalt(H)  │   lalt(J)  │ lalt(K)  │   lalt(L)  │     │     │
//    ├─────┼─────────┼─────────┼─────────┼─────────┼─────────┤         ├────────────┼────────────┼──────────┼────────────┼─────┼─────┤
//    │     │         │         │  left   │  rght   │         │         │            │     up     │   down   │            │     │     │
//    └─────┴─────────┴─────────┴─────────┴─────────┴─────────┘         └────────────┴────────────┴──────────┴────────────┴─────┴─────┘
//                              ┌─────┬─────┬───────────┐                     ┌─────┬─────┬─────┐
//                              │     │ del │ lgui(spc) │                     │     │     │     │
//                              └─────┴─────┴───────────┘                     └─────┴─────┴─────┘
    &trans   &kp LG(N1)   &kp LG(N2)   &kp LG(N3)   &kp LG(N4)   &kp LG(N5)      &kp LG(LEFT)   &kp LG(DOWN)   &kp LG(UP)   &kp LG(RIGHT)   &trans   &trans
    &trans   &kp LA(N1)   &kp LA(N2)   &kp LA(N3)   &kp LA(N4)   &kp LA(N5)      &kp LA(H)      &kp LA(J)      &kp LA(K)    &kp LA(L)       &trans   &trans
    &trans   &trans       &trans       &kp LEFT     &kp RIGHT    &trans          &trans         &kp UP         &kp DOWN     &trans          &trans   &trans
                                       &kp DEL   &kp LG(SPACE)   &trans       &trans   &trans   &trans
            >;
        };

        layer_Num {
            display-name = "Num";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐         ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │         │     │  7  │  8  │  9  │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤         ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │         │     │  4  │  5  │  6  │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤         ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │         │  0  │  1  │  2  │  3  │     │     │
//    └─────┴─────┴─────┴─────┴─────┴─────┘         └─────┴─────┴─────┴─────┴─────┴─────┘
//                      ┌─────┬─────┬────────┐      ┌─────┬─────┬─────┐
//                      │     │     │ to DEF │      │     │  ,  │  .  │
//                      └─────┴─────┴────────┘      └─────┴─────┴─────┘
    &trans   &trans   &trans   &trans   &trans   &trans       &trans   &kp N7      &kp N8    &kp N9   &trans   &trans
    &trans   &trans   &trans   &trans   &trans   &trans       &trans   &kp N4      &kp N5    &kp N6   &trans   &trans
    &trans   &trans   &trans   &trans   &trans   &trans       &kp N0   &kp N1      &kp N2    &kp N3   &trans   &trans
                               &trans   &to DEF   &trans       &trans   &kp COMMA   &kp DOT
            >;
        };

        layer_Fun {
            display-name = "Fun";
            bindings = <
//    ┌─────┬─────┬─────┬─────┬─────┬─────┐         ┌─────┬─────┬─────┬─────┬─────┬─────┐
//    │     │     │     │     │     │     │         │ F12 │ F7  │ F8  │ F9  │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤         ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │         │ F11 │ F4  │ F5  │ F6  │     │     │
//    ├─────┼─────┼─────┼─────┼─────┼─────┤         ├─────┼─────┼─────┼─────┼─────┼─────┤
//    │     │     │     │     │     │     │         │ F10 │ F1  │ F2  │ F3  │     │     │
//    └─────┴─────┴─────┴─────┴─────┴─────┘         └─────┴─────┴─────┴─────┴─────┴─────┘
//                      ┌─────┬─────┬────────┐      ┌─────┬─────┬─────┐
//                      │     │     │ to DEF │      │     │     │     │
//                      └─────┴─────┴────────┘      └─────┴─────┴─────┘
    &trans   &trans   &trans   &trans   &trans   &trans       &kp F12   &kp F7   &kp F8   &kp F9   &trans   &trans
    &trans   &trans   &trans   &trans   &trans   &trans       &kp F11   &kp F4   &kp F5   &kp F6   &trans   &trans
    &trans   &trans   &trans   &trans   &trans   &trans       &kp F10   &kp F1   &kp F2   &kp F3   &trans   &trans
                               &trans   &to DEF   &trans       &trans   &trans   &trans
            >;
        };

    };
};
